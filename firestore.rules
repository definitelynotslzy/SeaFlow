rules_version = '2';

// =====================================================================
// SeaFlow Firestore security rules
// These run on Google's servers for every read and write. The app's screens
// only reflect them; hiding a button never replaces a rule here.
//
// Who can do what (anything not listed is refused):
//
//   users            Admin: read all, create Clinic Staff accounts, deactivate or
//                    reactivate staff, withdraw or restore break-glass.
//                    Each clinic user: read their own account.
//   agencyRequests   Anyone signing up: create their own request (Pending).
//                    Admin: list all, approve, reject, suspend, reactivate.
//                    Agency: read its own; edit its own contact numbers and emails.
//                    Clinic staff: read agency profiles.
//   endorsements     Approved agency: create its own; read its own.
//                    Clinic staff and admin: read all (limited fields); accept.
//   patientDetails   Approved agency: create and read its own.
//                    Admin: read all. Clinic staff: read only on the clinic
//                    network or with running break-glass access for that record.
//   clinicVisits,    Clinic staff and admin: create and read.
//   billingStatements Approved agency: read its own.
//   breakGlass       Clinic staff: request (if not withdrawn), read and end their own.
//                    Admin: read all, review, end when withdrawing.
//   settings         Admin: save the access policy. Clinic users: read it.
//   networkPasses    Written only by the server check (api/network.js).
//                    Each clinic user: read their own.
//   auditLogs        Signed-in users: add entries about themselves. Anyone: add a
//                    failed or blocked sign-in. Admin: read. Nobody: edit or delete.
//
// Deactivated clinic accounts and suspended, rejected or pending agencies fail
// isClinicUser() / isApprovedAgency(), so they reach no patient data.
// Nothing can be deleted.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // AUTHENTICATION HELPERS
    // ==============================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "Active";
    }

    function isClinicUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ["admin", "staff"]
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "Active";
    }

    // Field checks shared by several collections.
    function isName(v) {
      return v is string && v.size() >= 2 && v.size() <= 100;
    }

    function isMobile(v) {
      return v is string && v.matches('^09[0-9]{9}$');
    }

    function isEmail(v) {
      return v is string && v.size() <= 254 && v.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isApprovedAgency() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/agencyRequests/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/agencyRequests/$(request.auth.uid)
        ).data.status == "Approved";
    }

    // ==============================
    // CLINIC USERS
    // ==============================

    match /users/{userId} {

      allow get: if (
        signedIn()
        && request.auth.uid == userId
      ) || isAdmin();

      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "name", "username", "role", "status", "duty", "createdAt"
        ])
        && isName(request.resource.data.name)
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._-]{3,50}$')
        && request.resource.data.role == "staff"
        && request.resource.data.status == "Active"
        && (request.resource.data.get("duty", null) == null
          || request.resource.data.duty in ["Endorsements and updates", "Billing", "Both"]);

      // Clinic Admin can deactivate/reactivate staff,
      // or withdraw/restore a staff member's break-glass privilege.
      allow update: if isAdmin()
        && resource.data.role == "staff"
        && request.resource.data.role == "staff"
        && (
          (
            resource.data.status in ["Active", "Deactivated"]
            && request.resource.data.status in ["Active", "Deactivated"]
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "status",
                "statusReason"
              ])
            && request.resource.data.statusReason is string
            && request.resource.data.statusReason.size() <= 300
          )
          || (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "breakGlassAllowed",
                "breakGlassNote"
              ])
            && request.resource.data.breakGlassAllowed is bool
            && request.resource.data.breakGlassNote is string
            && request.resource.data.breakGlassNote.size() <= 500
          )
        );

      allow delete: if false;
    }

    // ==============================
    // PATIENT ENDORSEMENTS
    // ==============================

    match /endorsements/{endorsementId} {

      // Approved agencies can submit endorsements.
      allow create: if isApprovedAgency()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.ref == endorsementId
        && request.resource.data.patientCode ==
          "PT-" + endorsementId
        && request.resource.data.status == "Pending"
        && request.resource.data.createdAt == request.time
        // Only these fields; private details go in patientDetails, never in this record.
        && request.resource.data.keys().hasOnly([
          "ref", "patientCode", "agencyId", "name", "case", "visitDate", "status",
          "receivedMs", "timeline", "turnaroundMin", "cashBasis", "updateRequested", "createdAt"
        ])
        && isName(request.resource.data.name)
        && request.resource.data.case is string
        && request.resource.data.case.size() >= 5
        && request.resource.data.case.size() <= 200
        && isDate(request.resource.data.visitDate)
        && request.resource.data.receivedMs is int
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() == 1
        && request.resource.data.timeline[0].label == "Received"
        && request.resource.data.turnaroundMin == null
        && request.resource.data.cashBasis == false
        && request.resource.data.updateRequested == false;

      // Clinic users can view all endorsements (limited fields only).
      // Agencies can view their own endorsements.
      allow get, list: if isClinicUser()
        || (
          isApprovedAgency()
          && resource.data.agencyId == request.auth.uid
        );

      // Clinic users can accept pending endorsements.
      allow update: if isClinicUser()
        && resource.data.status == "Pending"
        && request.resource.data.status == "Accepted"
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "status",
            "cashBasis",
            "turnaroundMin",
            "timeline",
            "acceptedAt",
            "acceptedBy"
          ])
        && request.resource.data.cashBasis is bool
        && request.resource.data.turnaroundMin is int
        && request.resource.data.turnaroundMin >= 1
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() ==
          resource.data.timeline.size() + 1
        && request.resource.data.timeline[
          request.resource.data.timeline.size() - 1
        ].label == "Accepted";

      allow delete: if false;
    }

    // ==============================
    // CLINIC NETWORK AND LIMITED VIEW
    // Full patient details live in patientDetails/{endorsement id}.
    // Clinic staff receive them only while on the clinic network (a network pass that
    // only the server, api/network.js, can write) or while break-glass access runs.
    // ==============================

    function privateFields() {
      return ["contact", "email", "birthday", "age", "address",
        "position", "vessel", "repatriation", "referral"];
    }

    function hasNetworkPass() {
      return exists(/databases/$(database)/documents/networkPasses/$(request.auth.uid))
        && get(/databases/$(database)/documents/networkPasses/$(request.auth.uid))
          .data.expiresAt > request.time;
    }

    // False once the clinic admin has withdrawn this user's break-glass privilege.
    function breakGlassAllowed() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get("breakGlassAllowed", true) == true;
    }

    function hasBreakGlassFor(endorsementId) {
      return breakGlassAllowed()
        && exists(/databases/$(database)/documents/breakGlass/$(request.auth.uid + "_" + endorsementId))
        && get(/databases/$(database)/documents/breakGlass/$(request.auth.uid + "_" + endorsementId))
          .data.expiresAt > request.time;
    }

    function breakGlassMinutes() {
      return exists(/databases/$(database)/documents/settings/accessPolicy)
        ? get(/databases/$(database)/documents/settings/accessPolicy).data.breakGlassMinutes
        : 30;
    }

    match /patientDetails/{endorsementId} {
      // Saved by the agency together with the endorsement (same batch).
      allow create: if isApprovedAgency()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.keys().hasOnly(privateFields().concat(["agencyId"]))
        && isMobile(request.resource.data.contact)
        && isEmail(request.resource.data.email)
        && isDate(request.resource.data.birthday)
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200
        && request.resource.data.position is string
        && request.resource.data.position.size() <= 50
        && request.resource.data.vessel is string
        && request.resource.data.vessel.size() <= 60
        && getAfter(
          /databases/$(database)/documents/endorsements/$(endorsementId)
        ).data.agencyId == request.auth.uid;

      allow get: if isAdmin()
        || (isApprovedAgency() && resource.data.agencyId == request.auth.uid)
        || (isClinicUser() && (hasNetworkPass() || hasBreakGlassFor(endorsementId)));

      allow list: if isAdmin()
        || (isApprovedAgency() && resource.data.agencyId == request.auth.uid)
        || (isClinicUser() && hasNetworkPass());

      allow update, delete: if false;
    }

    // Written only by the server (the Admin SDK skips these rules).
    match /networkPasses/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Access policy: the clinic network, break-glass length and idle sign-out.
    match /settings/{settingId} {
      allow get: if isClinicUser();
      allow list: if false;
      allow create, update: if isAdmin()
        && settingId == "accessPolicy"
        && request.resource.data.keys().hasOnly([
          "network", "breakGlassMinutes", "autoLogoutMinutes", "updatedBy", "updatedAt"
        ])
        && request.resource.data.network is string
        && request.resource.data.network.size() > 0
        && request.resource.data.network.size() <= 200
        && request.resource.data.breakGlassMinutes in [15, 30, 60]
        && request.resource.data.autoLogoutMinutes in [5, 10, 15, 30]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Break-glass: one record per staff member and endorsement, reused once it has ended.
    // It ends at expiresAt. Ending early (sign-out, time-out, a new sign-in, or the admin
    // withdrawing the privilege) sets expiresAt to that moment.
    function breakGlassIsValid(grantId) {
      let d = request.resource.data;
      return isClinicUser()
        && breakGlassAllowed()
        && d.keys().hasOnly(["endorsementId", "uid", "name", "reason", "note",
          "minutes", "status", "createdAt", "expiresAt"])
        && d.uid == request.auth.uid
        && grantId == request.auth.uid + "_" + d.endorsementId
        && d.endorsementId is string
        && exists(/databases/$(database)/documents/endorsements/$(d.endorsementId))
        && d.name is string && d.name.size() <= 200
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 60
        && d.note is string && d.note.size() > 0 && d.note.size() <= 1000
        && d.minutes == breakGlassMinutes()
        && d.status == "New"
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        // The policy's length, plus two minutes for a device clock that runs a little fast.
        && d.expiresAt <= request.time + duration.value(breakGlassMinutes() * 60 + 120, "s");
    }

    // Ends a grant that is still open, now, for one of the given reasons.
    function breakGlassEndsNow(reasons) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(["expiresAt", "endedAt", "endReason"])
        && resource.data.expiresAt > request.time
        && d.expiresAt == request.time
        && d.endedAt == request.time
        && d.endReason in reasons;
    }

    function breakGlassReview() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reviewNote", "reviewedBy", "reviewedAt"])
        && d.status in ["Reviewed", "Flagged"]
        && d.reviewNote is string && d.reviewNote.size() <= 1000
        && d.reviewedBy == request.auth.uid
        && d.reviewedAt == request.time;
    }

    match /breakGlass/{grantId} {
      // Staff read their own grants; the admin reads all of them (live alerts).
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if breakGlassIsValid(grantId);
      allow update: if
        // A new request for the same record after the last one ended.
        (breakGlassIsValid(grantId) && resource.data.expiresAt <= request.time)
        // Staff end their own open access when they sign out, time out or sign in again.
        || (signedIn() && resource.data.uid == request.auth.uid
          && breakGlassEndsNow(["Signed out", "Timed out", "Session ended"]))
        // The admin ends open access when withdrawing the privilege.
        || (isAdmin() && breakGlassEndsNow(["Privilege withdrawn"]))
        // The admin's review.
        || (isAdmin() && breakGlassReview());
      allow delete: if false;
    }

    // ==============================
    // MANNING AGENCY REQUESTS
    // ==============================

    // The authorized representative, and the person in charge of medical report and billing.
    function contactPersonIsValid(p) {
      return p.keys().hasOnly(["name", "position", "contact", "email"])
        && p.keys().hasAll(["name", "position", "contact", "email"])
        && isName(p.name)
        && p.position is string && p.position.size() >= 2 && p.position.size() <= 100
        && isMobile(p.contact)
        && isEmail(p.email);
    }

    match /agencyRequests/{requestId} {

      // Admin/staff can view agency profiles.
      // Agencies can view their own profile.
      allow get: if isClinicUser()
        || (
          signedIn()
          && request.auth.uid == requestId
        );

      // Only admin can list all agency requests.
      allow list: if isAdmin();

      // Agency registration.
      allow create: if signedIn()
        && request.auth.uid == requestId
        // A clinic account cannot also register as an agency.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly([
          "agencyName",
          "address",
          "authorized",
          "billing",
          "username",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "agencyName",
          "address",
          "authorized",
          "billing",
          "username",
          "status",
          "createdAt"
        ])
        && request.resource.data.agencyName is string
        && request.resource.data.agencyName.size() > 0
        && request.resource.data.agencyName.size() <= 200
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 500
        && request.resource.data.username is string
        && request.resource.data.username.matches(
          '^[a-z0-9._-]{3,50}$'
        )
        && request.resource.data.authorized is map
        && request.resource.data.billing is map
        && contactPersonIsValid(request.resource.data.authorized)
        && contactPersonIsValid(request.resource.data.billing)
        && request.resource.data.status == "Pending"
        && request.resource.data.createdAt == request.time;

      // Admin approves or rejects pending agencies.
      // Admin suspends approved agencies and reactivates suspended ones.
      // Approved agencies can edit their own contact details.
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "status",
              "statusReason"
            ])
          && request.resource.data.statusReason is string
          && (
            (resource.data.status == "Pending"
              && request.resource.data.status in ["Approved", "Rejected"])
            || (resource.data.status == "Approved"
              && request.resource.data.status == "Suspended")
            || (resource.data.status == "Suspended"
              && request.resource.data.status == "Approved")
          )
        )
        || (
          signedIn()
          && request.auth.uid == requestId
          && resource.data.status == "Approved"
          && request.resource.data.status == "Approved"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "address",
              "authorized",
              "billing"
            ])
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.authorized is map
          && request.resource.data.billing is map
          && request.resource.data.authorized
            .diff(resource.data.authorized)
            .affectedKeys().hasOnly([
              "contact",
              "email"
            ])
          && request.resource.data.billing
            .diff(resource.data.billing)
            .affectedKeys().hasOnly([
              "contact",
              "email"
            ])
          && isMobile(request.resource.data.authorized.contact)
          && isEmail(request.resource.data.authorized.email)
          && isMobile(request.resource.data.billing.contact)
          && isEmail(request.resource.data.billing.email)
        );

      allow delete: if false;
    }
    
    // ==============================
    // CLINIC VISITS — metadata only
    // ==============================
    
match /clinicVisits/{visitId} {
  allow create: if isClinicUser()
    && request.resource.data.keys().hasOnly([
      "endorsementId", "agencyId", "status",
      "report", "reportFile", "createdBy", "createdAt"
    ])
    && request.resource.data.keys().hasAll([
      "endorsementId", "agencyId", "status",
      "report", "reportFile", "createdBy", "createdAt"
    ])
    && request.resource.data.endorsementId is string
    && request.resource.data.agencyId is string
    && request.resource.data.status in [
      "Treatment in Progress",
      "Non-reporting Status",
      "Fit to Work",
      "Fit to Work with Disability",
      "Reach Maximum Medical Improvement",
      "Stop Treatment",
      "Expired"
    ]
    && request.resource.data.report is string
    && request.resource.data.report.size() > 0
    && request.resource.data.report.size() <= 255
    && request.resource.data.reportFile is map
    && request.resource.data.reportFile.keys().hasOnly([
      "path", "name", "contentType"
    ])
    && request.resource.data.reportFile.keys().hasAll([
      "path", "name", "contentType"
    ])
    && request.resource.data.reportFile.path is string
    && request.resource.data.reportFile.path.matches(
      "^endorsements/" +
      request.resource.data.endorsementId +
      "/medical-reports/" +
      visitId +
      "/[A-Za-z0-9_-]+\\.(pdf|jpg|png)$"
    )
    && request.resource.data.reportFile.name is string
    && request.resource.data.reportFile.name.size() > 0
    && request.resource.data.reportFile.name.size() <= 255
    && request.resource.data.reportFile.contentType in [
      "application/pdf", "image/jpeg", "image/png"
    ]
    && request.resource.data.report ==
      request.resource.data.reportFile.name
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time
    && exists(
      /databases/$(database)/documents/endorsements/$(request.resource.data.endorsementId)
    )
    && get(
      /databases/$(database)/documents/endorsements/$(request.resource.data.endorsementId)
    ).data.agencyId == request.resource.data.agencyId
    && get(
      /databases/$(database)/documents/endorsements/$(request.resource.data.endorsementId)
    ).data.status in [
      "Accepted",
      "Treatment in Progress",
      "Non-reporting Status"
    ];

  allow get, list: if isClinicUser() ||
    (
      isApprovedAgency() &&
      resource.data.agencyId == request.auth.uid
    );

  allow update, delete: if false;
}


    // ==============================
    // BILLING STATEMENTS — one per visit
    // ==============================
    match /billingStatements/{billingId} {
      allow create: if isClinicUser()
        && request.resource.data.keys().hasOnly([
          "endorsementId", "agencyId", "visitId", "file", "createdBy", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "endorsementId", "agencyId", "visitId", "file", "createdBy", "createdAt"
        ])
        && request.resource.data.visitId == billingId
        && request.resource.data.visitId is string
        && request.resource.data.endorsementId is string
        && request.resource.data.agencyId is string
        && request.resource.data.file is string
        && request.resource.data.file.size() > 0
        && request.resource.data.file.size() <= 255
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/clinicVisits/$(billingId))
        && get(/databases/$(database)/documents/clinicVisits/$(billingId)).data.endorsementId == request.resource.data.endorsementId
        && get(/databases/$(database)/documents/clinicVisits/$(billingId)).data.agencyId == request.resource.data.agencyId;
      allow get, list: if isClinicUser() ||
        (isApprovedAgency() && resource.data.agencyId == request.auth.uid);
      allow update, delete: if false;
    }

    // ==============================
    // AUDIT LOG
    // Anyone signed in can add an entry about themselves.
    // Someone not signed in can only add a failed or blocked sign-in.
    // Only the clinic admin can read it. Nobody can change or delete an entry.
    // ==============================

    function auditEntryIsValid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          "actorId", "actorName", "actorType", "role", "action",
          "record", "details", "outcome", "network", "createdAt"
        ])
        && d.createdAt == request.time
        && d.action is string && d.action.size() > 0 && d.action.size() <= 60
        && d.actorName is string && d.actorName.size() <= 200
        && d.record is string && d.record.size() <= 50
        && d.details is string && d.details.size() <= 1000
        && d.network is string && d.network.size() <= 60
        && d.outcome in ["allowed", "denied"]
        && d.role in ["Clinic Staff", "Clinic Admin", "Manning Agency", ""];
    }

    function auditIsOwnEntry() {
      let d = request.resource.data;
      return signedIn()
        && d.actorId == request.auth.uid
        && ((d.actorType == "clinic" && isClinicUser() && d.role != "Manning Agency")
          || (d.actorType == "agency" && isApprovedAgency() && d.role == "Manning Agency"));
    }

    function auditIsSignInFailure() {
      let d = request.resource.data;
      return !signedIn()
        && d.actorId == ""
        && d.actorType == "unknown"
        && d.outcome == "denied"
        && d.action in ["Failed sign-in", "Sign-in blocked"];
    }

    match /auditLogs/{entryId} {
      allow read: if isAdmin();
      allow create: if auditEntryIsValid()
        && (auditIsOwnEntry() || auditIsSignInFailure());
      allow update, delete: if false;
    }

    // Everything else is refused. (Firestore already refuses anything without a rule;
    // this line makes that visible.)
    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
